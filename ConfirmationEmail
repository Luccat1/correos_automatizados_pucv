/***** LÓGICA DE NEGOCIO *****/

function isPucvEmail_(email) {
    return email.endsWith("@pucv.cl") || email.endsWith("@mail.pucv.cl");
}

function isGerman_(idioma) {
    return idioma.toLowerCase().includes("alemán") || idioma.toLowerCase().includes("aleman");
}

function determineDiscountCode_(email, idioma, esContinuacion) {
    const isPucv = isPucvEmail_(email);
    const isGerman = isGerman_(idioma);

    if (isGerman) {
        if (isPucv && esContinuacion) {
            return CFG_CONF.discounts.german_continuation_pucv;
        }
        return CFG_CONF.discounts.german;
    }

    if (isPucv) {
        return CFG_CONF.discounts.pucv;
    }

    return CFG_CONF.discounts.base;
}

function determineCCs_(idioma) {
    const idiomaNormalizado = idioma.toLowerCase();

    // Buscar coincidencia en las llaves del mapa de CCs
    for (const key in CFG_CONF.ccs) {
        if (key !== "default" && idiomaNormalizado.includes(key)) {
            return CFG_CONF.ccs[key];
        }
    }
    return CFG_CONF.ccs["default"] || "";
}

/***** HELPERS *****/
function getSheet_Conf_() {
    const ss = SpreadsheetApp.openById(CFG_CONF.spreadsheetId);
    let sh = ss.getSheetByName(CFG_CONF.sheetName);
    if (!sh) sh = ss.getSheets()[0];
    return sh;
}

function getHeaderIndexes_Conf_(sh) {
    const headers = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0].map(String);
    const col = {};
    const lowerHeaders = headers.map(h => h.toLowerCase().trim());

    Object.keys(HEADERS_CONF).forEach(k => {
        const target = HEADERS_CONF[k];
        const idx = lowerHeaders.findIndex(h => h.includes(target));
        col[k] = idx;
    });
    return { headers, col };
}

function ensureStatusColumn_Conf_(sh, headers, name) {
    const lower = name.toLowerCase();
    let idx = headers.findIndex(h => h.toLowerCase().includes(lower));
    if (idx === -1) {
        idx = headers.length;
        sh.getRange(1, idx + 1).setValue(name);
    }
    return idx + 1;
}

function safeCell_Conf_(row, idx) {
    return (idx !== undefined && idx >= 0) ? (row[idx] || "").toString().trim() : "";
}

