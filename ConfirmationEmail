    if (!activeUser) throw new Error("No se pudo obtener el correo del usuario activo.");

    const fakeData = {
        nombre: "Estudiante de Prueba",
        idioma: "Alemán",
        nivel: "A1.1",
        horario: "Martes y Jueves 18:30 - 20:00",
        plazo: CFG_CONF.defaultPaymentDeadline,
        discountCode: "TEST-CODE-123",
        paymentUrl: CFG_CONF.paymentBaseUrl
