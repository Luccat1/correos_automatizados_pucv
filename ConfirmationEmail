/***** COLUMNAS ESPERADAS *****/
const HEADERS_CONF = {
    nombre: "nombre",
    correo: "correo",
    idioma: "idioma",
    nivel: "nivel",
    horario: "horario",
    plazo: "plazo",       // Nueva columna opcional
    es_continuacion: "es_continuacion",
    estado: "estado"
};

/***** PÚBLICAS *****/

/**
 * Función Principal: Envía los correos basándose en la lista.
 */
function sendConfirmationEmails() {
    const sh = getSheet_Conf_();
    const { headers, col } = getHeaderIndexes_Conf_(sh);
    const statusColIdx = ensureStatusColumn_Conf_(sh, headers, HEADERS_CONF.estado);

    const data = sh.getDataRange().getValues();
    if (data.length <= 1) return;

    let processed = 0;
    const updates = [];

    // Iterar filas de datos
    for (let r = 1; r < data.length; r++) {
        const row = data[r];
        const status = (row[statusColIdx - 1] || "").toString().toLowerCase();

        if (status.includes("enviado") || status.includes("error")) {
            updates.push([row[statusColIdx - 1]]);
            continue;
        }

        try {
            const nombre = safeCell_Conf_(row, col.nombre);
            const correo = safeCell_Conf_(row, col.correo);
            const idioma = safeCell_Conf_(row, col.idioma);
            const nivel = safeCell_Conf_(row, col.nivel);
            const horario = safeCell_Conf_(row, col.horario);
            const plazoRaw = safeCell_Conf_(row, col.plazo);
            const esContinuacion = safeCell_Conf_(row, col.es_continuacion).toLowerCase().includes("si");

            // Usar plazo de la columna o el por defecto
            const plazo = plazoRaw || CFG_CONF.defaultPaymentDeadline;

            if (!correo || !nombre) {
                updates.push(["Error: Faltan datos"]);
                continue;
            }

            // 1. Determinar Código de Descuento
            const discountCode = determineDiscountCode_(correo, idioma, esContinuacion);

            // 2. Determinar CCs
            const ccEmails = determineCCs_(idioma);

            // 3. Construir Correo
            const htmlBody = buildHtmlBody_Conf_({
                nombre,
                idioma,
                nivel,
                horario,
                plazo,
                discountCode,
                paymentUrl: CFG_CONF.paymentBaseUrl
            });

            const plainBody = buildPlainTextBody_Conf_({
                nombre,
                idioma,
                nivel,
                horario,
                plazo,
                discountCode,
                paymentUrl: CFG_CONF.paymentBaseUrl
            });

            // 4. Enviar o Crear Borrador
            if (CFG_CONF.createDrafts) {
                GmailApp.createDraft(correo, CFG_CONF.subjectTemplate(idioma, nivel), plainBody, {
                    htmlBody: htmlBody,
                    name: CFG_CONF.senderName,
                    cc: ccEmails
                });
                updates.push([`Borrador ${new Date().toLocaleString()}`]);
            } else {
                GmailApp.sendEmail(correo, CFG_CONF.subjectTemplate(idioma, nivel), plainBody, {
                    htmlBody: htmlBody,
                    name: CFG_CONF.senderName,
                    cc: ccEmails
                });
                updates.push([`Enviado ${new Date().toLocaleString()}`]);
            }

            processed++;

        } catch (e) {
            updates.push([`Error: ${e.message}`]);
        }
    }

    // Escribir estados de vuelta
    sh.getRange(2, statusColIdx, updates.length, 1).setValues(updates);
    Logger.log(`Procesados: ${processed}`);
}

