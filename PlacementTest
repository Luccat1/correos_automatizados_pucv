/**
 * Procesa la lista de estudiantes y envía correos o crea borradores.
 * Optimizado para leer y escribir en bloque (Batch Operations).
 */
function sendReminderEmails() {
    const sh = getSheet_Rec_();
    const { headers, col } = getHeaderIndexes_Rec_(sh);
    const statusColIdx = ensureStatusColumn_Rec_(sh, headers, CFG_REC.statusColumnName);

    const dataRange = sh.getDataRange();
    const rows = dataRange.getValues();

    if (rows.length <= 1) {
        Logger.log("No hay filas de datos.");
        return;
    }

    // 0. Verificar Cuota Inicial
    const remainingQuota = MailApp.getRemainingDailyQuota();
    Logger.log(`Cuota diaria restante: ${remainingQuota}`);
    if (remainingQuota < 1) {
        Logger.log("Cuota agotada. No se pueden enviar más correos hoy.");
        Browser.msgBox("Cuota agotada", "Has alcanzado el límite diario de envíos de Google. Intenta nuevamente mañana.", Browser.Buttons.OK);
        return;
    }

    // Preparamos matriz para actualizar estados en lote al final
    // Inicializamos con los valores actuales para no sobrescribir con vacíos si no tocamos la fila
    // Ojo: statusColIdx es 1-based, en el array 'rows' el índice es statusColIdx - 1
    const statusUpdates = rows.map(row => [row[statusColIdx - 1]]);

    let processed = 0;
    const timeString = new Date().toLocaleString();

    // Iteramos desde la fila 2 (índice 1)
    for (let r = 1; r < rows.length; r++) {
        // Chequeo de seguridad de cuota dentro del bucle (por si acaso)
        if (processed >= remainingQuota) {
            Logger.log("Se alcanzó el límite de cuota durante el proceso. Deteniendo.");
            break;
        }

        const row = rows[r];
        const rowNumber = r + 1; // Fila en hoja (1-based)

        // 1. Validar Correo
        const to = safeCell_Rec_(row, col.correo);
        if (!to) continue; // Si no hay correo, saltamos

        // 2. Validar si ya fue procesado
        if (CFG_REC.skipAlreadyProcessed) {
            const existingStatus = (statusUpdates[r][0] || "").toString().toLowerCase();
            if (existingStatus.includes("enviado") || existingStatus.includes("borrador")) {
                continue;
            }
        }

        try {
            // 3. Extraer y validar datos
            const username = required_Rec_(row, col.userId, "User Id", rowNumber);
            const password = required_Rec_(row, col.password, "Password", rowNumber);

            let institutionId = safeCell_Rec_(row, col.institution);
            if (!institutionId && CFG_REC.defaultInstitutionId) institutionId = CFG_REC.defaultInstitutionId;
            if (!institutionId) throw new Error(`Falta Institutional ID`);

            const nombre = safeCell_Rec_(row, col.nombre);
            const firstName = extractFirstName_Rec_(nombre);

            // 4. Construir contenido
            const subject = CFG_REC.subjectTemplate(firstName);
            const htmlBody = buildHtmlBody_Rec_({
                placementUrl: CFG_REC.placementUrl,
                username, password, institutionId, firstName
            });
            const plainBody = buildPlainTextBody_Rec_({
                placementUrl: CFG_REC.placementUrl,
                username, password, institutionId, firstName
            });

            // 5. Configurar opciones de envío (CC, BCC, Nombre)
            const options = {
                htmlBody: htmlBody,
                name: CFG_REC.senderName,
                cc: CFG_REC.cc,
                bcc: CFG_REC.bcc
            };

            // 6. Enviar o Crear Borrador
            if (CFG_REC.createDraftsOnly) {
                GmailApp.createDraft(to, subject, plainBody, options);
                statusUpdates[r][0] = `Borrador creado ${timeString}`;
            } else {
                GmailApp.sendEmail(to, subject, plainBody, options);
                statusUpdates[r][0] = `Enviado ${timeString}`;
            }

            processed++;

        } catch (e) {
            const errorMsg = e.message;
            Logger.log(`Error en fila ${rowNumber}: ${errorMsg}`);

            // Si el error es de cuota, detenemos TODO el proceso inmediatamente
            if (errorMsg.includes("Service invoked too many times") || errorMsg.includes("limit")) {
                statusUpdates[r][0] = `Error: Límite diario alcanzado.`;
                Logger.log("ABORTANDO: Se detectó error de límite de envío.");

                // Guardamos lo que llevamos hasta ahora antes de salir
                sh.getRange(1, statusColIdx, statusUpdates.length, 1).setValues(statusUpdates);
                Browser.msgBox("Proceso Detenido", "Se alcanzó el límite de correos diarios de Google. El script se detuvo para evitar más errores. Continúa mañana.", Browser.Buttons.OK);
                return; // Salimos de la función
            }

            statusUpdates[r][0] = `Error: ${errorMsg}`;
        }
    }

    // 7. Escribir actualizaciones de estado en lote (Eficiencia)
    // Solo escribimos la columna de estado
    if (processed > 0 || !CFG_REC.skipAlreadyProcessed) {
        sh.getRange(1, statusColIdx, statusUpdates.length, 1).setValues(statusUpdates);
    }

    Logger.log(`${CFG_REC.createDraftsOnly ? "Borradores" : "Correos"} procesados: ${processed}`);
}

/**
 * Envía un correo de prueba con datos falsos.
 * Puede enviar a múltiples destinatarios si se configuran en CFG_REC.testRecipients
 */
function sendGenericTestEmail() {
    const fakeData = {
        username: "USUARIO_PRUEBA_123",
        password: "PASSWORD_123",
        institutionId: "INST_ID_999",
        firstName: "Estudiante de Prueba",
        placementUrl: CFG_REC.placementUrl
    };

    // Determinar destinatarios
    let recipients = CFG_REC.testRecipients;
    if (!recipients || recipients.length === 0) {
        const activeUser = Session.getActiveUser().getEmail();
        if (activeUser) {
            recipients = [activeUser];
        } else {
            throw new Error("No se pudo detectar el email del usuario activo y no hay testRecipients configurados.");
        }
    }

    const to = recipients.join(",");

    const subject = "[PRUEBA] " + CFG_REC.subjectTemplate(fakeData.firstName);
    const htmlBody = buildHtmlBody_Rec_(fakeData);
    const plainBody = buildPlainTextBody_Rec_(fakeData);

    const options = {
        htmlBody: htmlBody,
        name: CFG_REC.senderName,
        cc: CFG_REC.cc,
        bcc: CFG_REC.bcc
    };

    GmailApp.sendEmail(to, subject, plainBody, options);
    Logger.log(`Correo de prueba enviado a: ${to}`);
}

/**
 * Previsualiza una fila específica creando un borrador.
 */
function previewOneReminder(rowNumber) {
    const sh = getSheet_Rec_();
    const { headers, col } = getHeaderIndexes_Rec_(sh);
    rowNumber = Number(rowNumber) || 2;

    const lastRow = sh.getLastRow();
    if (rowNumber < 2 || rowNumber > lastRow) throw new Error(`Fila fuera de rango.`);

    const row = sh.getRange(rowNumber, 1, 1, sh.getLastColumn()).getValues()[0];

    // Validar datos mínimos
    const to = required_Rec_(row, col.correo, "Correo", rowNumber);
    const username = required_Rec_(row, col.userId, "User Id", rowNumber);
    const password = required_Rec_(row, col.password, "Password", rowNumber);

    let institutionId = safeCell_Rec_(row, col.institution);
    if (!institutionId && CFG_REC.defaultInstitutionId) institutionId = CFG_REC.defaultInstitutionId;

    const nombre = safeCell_Rec_(row, col.nombre);
    const firstName = extractFirstName_Rec_(nombre);
    const subject = CFG_REC.subjectTemplate(firstName);

    const htmlBody = buildHtmlBody_Rec_({ placementUrl: CFG_REC.placementUrl, username, password, institutionId, firstName });
    const plainBody = buildPlainTextBody_Rec_({ placementUrl: CFG_REC.placementUrl, username, password, institutionId, firstName });

    const options = {
        htmlBody: htmlBody,
        name: CFG_REC.senderName,
        cc: CFG_REC.cc,
        bcc: CFG_REC.bcc
    };

    GmailApp.createDraft(to, subject, plainBody, options);
    Logger.log(`Borrador de prueba creado para fila ${rowNumber} -> ${to}`);
}

/***** HELPERS (INTERNOS) *****/

function getSheet_Rec_() {
    const ss = SpreadsheetApp.openById(CFG_REC.spreadsheetId);
    const sh = ss.getSheetByName(CFG_REC.sheetName);
    if (!sh) throw new Error(`No existe la hoja "${CFG_REC.sheetName}".`);
    return sh;
}

function getHeaderIndexes_Rec_(sh) {
    const headers = (sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0] || []).map(h => (h || "").toString().trim());
    const lower = headers.map(h => h.toLowerCase());
    const col = {};
    Object.entries(EXPECTED_HEADERS_REC).forEach(([key, label]) => {
        const idx = lower.indexOf(label);
        if (idx === -1) throw new Error(`No se encontró columna "${label}"`);
        col[key] = idx;
    });
    return { headers, col };
}

function ensureStatusColumn_Rec_(sh, headers, statusName) {
    let idx = headers.findIndex(h => h.toLowerCase() === statusName.toLowerCase());
    if (idx === -1) {
        idx = headers.length;
        sh.getRange(1, idx + 1).setValue(statusName);
    }
    return idx + 1;
}

function required_Rec_(row, idx, name, rowNum) {
    const val = safeCell_Rec_(row, idx);
    if (!val) throw new Error(`Falta "${name}".`);
    return val;
}

function safeCell_Rec_(row, idx) {
    return (idx !== undefined && idx !== null) ? (row[idx] || "").toString().trim() : "";
}

function extractFirstName_Rec_(nombre) {
    if (!nombre) return "";
    return nombre.trim().split(/\s+/)[0] || "";
}

function escapeHtml_Rec_(str) {
    return String(str).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
}

