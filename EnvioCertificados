};

/***** MAPEO DE COLUMNAS *****/
const COL_ALFAB = {
    nombre: "Nombre",
    apellido: "Apellido",
    email: "Correo",
    link: "Enlace", // El texto del hipervínculo
    estado: "Estado" // Columna para registrar el envío
};

/***** FUNCIONES PRINCIPALES *****/

/**
 * Función de Prueba:
 * Envía un solo correo a CFG_ALFAB.testEmail (o al usuario activo)
 * usando los datos de la primera fila válida de la hoja.
 */
function enviarPruebaAlfabetizacion() {
    const sh = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
    const { idx } = getHeaderIndexes_Alfab_(sh);
    
    // Obtenemos datos de las 2 primeras filas (cabecera + 1ra de datos)
    const dataRange = sh.getRange(1, 1, 2, sh.getLastColumn());
    const data = dataRange.getValues();
    const richText = dataRange.getRichTextValues();

    if (data.length < 2) {
        SpreadsheetApp.getUi().alert("No hay datos en la hoja para realizar una prueba.");
        return;
    }

    const rowVal = data[1];
    const rowRich = richText[1];
    
    // Datos simulados extraídos de la hoja
    const nombre = safeCell_Alfab_(rowVal, idx.nombre);
    const apellido = safeCell_Alfab_(rowVal, idx.apellido);
    const emailOriginal = safeCell_Alfab_(rowVal, idx.email);
    
    // Extraer Link
    let linkUrl = "";
    if (rowRich[idx.link]) {
        linkUrl = rowRich[idx.link].getLinkUrl();
    }
    if (!linkUrl) {
        const txt = safeCell_Alfab_(rowVal, idx.link);
        if (txt.startsWith("http")) linkUrl = txt;
    }
    if (!linkUrl) linkUrl = "https://www.google.com"; // Link dummy si falla

    const fullName = `${nombre} ${apellido}`.trim();
    
    // Simular lógica de CCs para ver a quién le llegaría
    const ccsReales = determineCCs_Alfab_(emailOriginal);

    // Determinar email de destino de prueba
    let testDestinatario = CFG_ALFAB.testEmail;
    if (!testDestinatario) {
        testDestinatario = Session.getActiveUser().getEmail();
    }

    const subjectPrueba = `[PRUEBA] ${CFG_ALFAB.subject}`;
    
    // Cuerpo
    const htmlBody = buildHtmlBody_Alfab_({ nombre: fullName, link: linkUrl });
    const plainBody = buildPlainTextBody_Alfab_({ nombre: fullName, link: linkUrl });

    // Enviar prueba
    // OJO: En prueba enviamos TODO al tester (To y CC) para que no le llegue a nadie más.
    GmailApp.sendEmail(testDestinatario, subjectPrueba, plainBody, {
        htmlBody: htmlBody,
        name: `${CFG_ALFAB.senderName} (Test)`,
        cc: testDestinatario // Nos copiamos a nosotros mismos para verificar
    });

    SpreadsheetApp.getUi().alert(
        `Correo de prueba enviado a: ${testDestinatario}\n\n` +
        `Simulación para el usuario: ${fullName} (${emailOriginal})\n` +
        `En un envío REAL, los CC serían: ${ccsReales}`
    );
}

/**
 * Función Principal para ejecutar el envío masivo REAL.
 */
function enviarCertificadosAlfabetizacion() {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sh = ss.getActiveSheet(); 
    const { headers, idx } = getHeaderIndexes_Alfab_(sh);
    const statusColIdx = ensureStatusColumn_Alfab_(sh, headers, COL_ALFAB.estado);

    const dataRange = sh.getDataRange();
    const data = dataRange.getValues();
    const richTextData = dataRange.getRichTextValues();

    if (idx.email === undefined || idx.link === undefined) {
        SpreadsheetApp.getUi().alert("Error: No se encontraron las columnas 'Correo' o 'Enlace'.");
        return;
    }

    let processed = 0;
    
    for (let r = 1; r < data.length; r++) { 
        const rowVal = data[r];
        const rowRich = richTextData[r];
        const currentRowNum = r + 1; 

        const currentStatus = (rowVal[statusColIdx - 1] || "").toString();

        if (currentStatus.toLowerCase().includes("enviado")) {
            continue;
        }

        try {
            const nombre = safeCell_Alfab_(rowVal, idx.nombre);
            const apellido = safeCell_Alfab_(rowVal, idx.apellido);
            const emailRaw = safeCell_Alfab_(rowVal, idx.email);
            
            let linkUrl = "";
            const richText = rowRich[idx.link];
            if (richText) {
                linkUrl = richText.getLinkUrl();
            }
            if (!linkUrl) {
                const textVal = safeCell_Alfab_(rowVal, idx.link);
                if (textVal.startsWith("http")) {
                    linkUrl = textVal;
                }
            }

            if (!emailRaw) {
                sh.getRange(currentRowNum, statusColIdx).setValue("Error: Sin correo");
                continue;
            }
            if (!linkUrl) {
                // Si no hay link, intentar continuar con advertencia o saltar.
                // Mejor registrar error.
                if (!safeCell_Alfab_(rowVal, idx.link)) {
                     sh.getRange(currentRowNum, statusColIdx).setValue("Error: Sin enlace");
                     continue;
                }
                // Si hay texto pero no link valido detectado
            }

            const fullName = `${nombre} ${apellido}`.trim();

            // 1. Compartir archivo
            try {
                const fileId = extractFileId_Alfab_(linkUrl);
                if (fileId) {
                    shareFileWithUser_Alfab_(fileId, emailRaw);
                }
            } catch (shareError) {
                console.warn("Error share: " + shareError.message);
            }

            // 2. CCs
            const recipientsCC = determineCCs_Alfab_(emailRaw);

            // 3. Body
            const htmlBody = buildHtmlBody_Alfab_({
                nombre: fullName,
                link: linkUrl || safeCell_Alfab_(rowVal, idx.link)
            });
            const plainBody = buildPlainTextBody_Alfab_({
                nombre: fullName,
                link: linkUrl || safeCell_Alfab_(rowVal, idx.link)
            });

            // 4. Send
            GmailApp.sendEmail(emailRaw, CFG_ALFAB.subject, plainBody, {
                htmlBody: htmlBody,
                name: CFG_ALFAB.senderName,
                cc: recipientsCC
            });

            sh.getRange(currentRowNum, statusColIdx).setValue(`Enviado ${new Date().toLocaleString()}`);
            processed++;
            Utilities.sleep(500);

        } catch (e) {
            console.error(`Error fila ${currentRowNum}: ${e.message}`);
            sh.getRange(currentRowNum, statusColIdx).setValue(`Error: ${e.message}`);
        }
    }

    SpreadsheetApp.getUi().alert(`Proceso finalizado. Correos enviados: ${processed}`);
}

/***** LÓGICA DE NEGOCIO *****/

function determineCCs_Alfab_(emailDestinatario) {
    const emailNorm = emailDestinatario.trim().toLowerCase();
    
    let ccs = [...CFG_ALFAB.ccGeneral]; 

    const listaUAntof = CFG_ALFAB.emailsUAntofagasta.map(e => e.toLowerCase());

    if (listaUAntof.includes(emailNorm)) {
        ccs.push(CFG_ALFAB.ccUAntofagasta);
    } 

    return ccs.join(",");
}

/***** HELPERS DRIVE Y SHEET *****/

function extractFileId_Alfab_(url) {
    if (!url) return null;
    let match = url.match(/\/d\/([a-zA-Z0-9-_]+)/);
    if (match) return match[1];
    match = url.match(/id=([a-zA-Z0-9-_]+)/);
    if (match) return match[1];
    return null;
}

function shareFileWithUser_Alfab_(fileId, email) {
    try {
        const file = DriveApp.getFileById(fileId);
        file.addViewer(email);
    } catch (e) {
        throw new Error("Drive share error: " + e.message);
    }
}

function getHeaderIndexes_Alfab_(sh) {
    const headers = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0].map(h => h.toString().trim());
    const idx = {};
    
    for (const [key, colName] of Object.entries(COL_ALFAB)) {
        const i = headers.findIndex(h => h.toLowerCase() === colName.toLowerCase());
        if (i >= 0) idx[key] = i;
    }
    return { headers, idx };
}

function ensureStatusColumn_Alfab_(sh, headers, colName) {
    let idx = headers.findIndex(h => h.toString().toLowerCase() === colName.toLowerCase());
    if (idx === -1) {
        idx = headers.length;
        sh.getRange(1, idx + 1).setValue(colName);
    }
    return idx + 1; 
}

function safeCell_Alfab_(row, idx) {
    return (idx !== undefined && idx >= 0) ? (row[idx] || "").toString().trim() : "";
}

