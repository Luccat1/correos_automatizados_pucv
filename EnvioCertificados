    surveyUrl: "https://forms.gle/YCXwd1gitrWYriXo7",

    // Correos de autoridades / CC
    ccGeneral: ["rene.venegas@pucv.cl", "paloma.vallejos.r@mail.pucv.cl"],
    
    // Lista específica U. Antofagasta para CC adicional a Marcelo Olivares
    ccUAntofagasta: "MARCELO.OLIVARES@uantof.cl",
    emailsUAntofagasta: [
        "jmcasanoba@gmail.com",
        "bustoskerem@gmail.com",
        "marijose.gamboa27@gmail.com",
        "mariamunozfriz@gmail.com",
        "plucirre@gmail.com"
    ],

    // Correo para pruebas (se usa en la función enviarPruebaAlfabetizacion)
